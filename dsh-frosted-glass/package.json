{
  "name": "dsh-frosted-glass",
  "version": "0.1.0",
  "description": "毛玻璃皮肤 for DeepSeek Harness: 真正的 backdrop blur + 半透明表面 token + 自定义壁纸。Frosted-glass skin: real backdrop blur over translucent surface tokens, with a full-page wallpaper.",
  "license": "MIT",
  "author": "luoxin",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/plugin.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "@types/react": "^18.3.0",
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "react": "^18.2.0",
    "typescript": "^5.6.0"
  }
}
